{
  "info": {
    "name": "DevTinder API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7777"
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Signup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Ayush\",\n  \"lastName\": \"Nagar\",\n  \"emailId\": \"ayush.nagar.dev@example.com\",\n  \"password\": \"StrongPassword@123\",\n  \"age\": 21,\n  \"gender\": \"male\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/signup",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "signup"
          ]
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emailId\": \"ayush.nagar.dev@example.com\",\n  \"password\": \"StrongPassword@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        }
      }
    },
    {
      "name": "Profile - reads login cookie",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "profile"
          ]
        }
      }
    },
    {
      "name": "Get user by email",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emailId\": \"ayush.nagar.dev@example.com\"\n}"
        },
        "event": [
          {
            "listen": "test",
            "script": {
              "exec": [
                "const user = pm.response.json();",
                "if (user && user._id) pm.collectionVariables.set('userId', user._id);"
              ],
              "type": "text/javascript"
            }
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/user",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user"
          ]
        }
      }
    },
    {
      "name": "Update user",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"about\": \"I build JavaScript applications.\",\n  \"skills\": [\"JavaScript\", \"Node.js\", \"MongoDB\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/user/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user",
            "{{userId}}"
          ]
        }
      }
    },
    {
      "name": "Delete user",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"_id\": \"{{userId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/user",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user"
          ]
        }
      }
    }
  ]
}
